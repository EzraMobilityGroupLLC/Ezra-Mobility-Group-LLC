---
import siteData from "../config/siteData.json";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const pageTitle = title
  ? `${title} | ${siteData.site.name}`
  : `${siteData.site.shortName} — ${siteData.site.tagline}`;
const pageDesc = description || siteData.site.description;
const pageCanonical = canonical || siteData.site.url;
---

<!doctype html>
<html lang={siteData.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content={siteData.brand.darkBg} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={`${siteData.site.url}/images/og-image.jpg`} />
    <meta property="og:url" content={pageCanonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <link rel="canonical" href={pageCanonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
