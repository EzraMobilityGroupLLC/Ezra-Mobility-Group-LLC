---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../config/siteData.json";
const about = siteData.about;
---

<BaseLayout title="About Us" description={about.mission}>
  <Header />
  <main>
    <section class="section">
      <div class="container container-narrow">
        <div class="section-label animate-in">About Ezra Mobility Group LLC</div>
        <h1 class="section-title animate-in animate-in-delay-1">Building Austin's Premium Luxury Vehicle Fleet</h1>
        <p class="section-subtitle animate-in animate-in-delay-2">{about.story}</p>
      </div>
    </section>
    <section class="section section-dark">
      <div class="container container-narrow">
        <div class="veteran-badge animate-in">
          <span class="veteran-badge__icon">🇺🇸</span>
          <span class="veteran-badge__text">100% Veteran-Owned Business</span>
        </div>
        <h2 class="section-title">Our Mission</h2>
        <div class="accent-line"></div>
        <p style="color:var(--text-secondary); line-height:1.8; font-size:1.05rem;">{about.mission}</p>
      </div>
    </section>
    <section class="section">
      <div class="container container-narrow">
        <h2 class="section-title">Our Values</h2>
        <div class="accent-line"></div>
        <div class="values__grid">
          {about.values.map((v, i) => (
            <div class="value-card animate-in" style={`animation-delay: ${i * 0.1}s`}>
              <h3>{v.title}</h3>
              <p>{v.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container container-narrow">
        <h2 class="section-title">About the Founder</h2>
        <div class="accent-line"></div>
        <div class="founder-card animate-in">
          <h3 class="founder-card__name">{about.founder.name}</h3>
          <p class="founder-card__title">{about.founder.title}</p>
          <p class="founder-card__bio">{about.founder.bio}</p>
        </div>
      </div>
    </section>
    <section class="section section-dark text-center">
      <div class="container container-narrow">
        <h2 class="section-title">Ready to Partner?</h2>
        <p class="section-subtitle" style="margin:0 auto var(--gap-lg);">We're actively seeking investment partners, owner-operators, and fleet drivers for our Austin launch.</p>
        <a href="/contact" class="btn btn-primary btn-lg">Contact Us</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .values__grid { display: grid; gap: var(--gap-lg); }
  .value-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: var(--gap-lg); }
  .value-card h3 { font-size: 1.1rem; margin-bottom: var(--gap-sm); }
  .value-card p { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; }
  .veteran-badge { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255,105,180,0.08); border: 1px solid rgba(255,105,180,0.2); padding: 0.5rem 1rem; border-radius: var(--radius-sm); margin-bottom: var(--gap-lg); }
  .veteran-badge__icon { font-size: 1.2rem; }
  .veteran-badge__text { font-size: 0.9rem; font-weight: 600; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.05em; }
  .founder-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: var(--gap-xl); }
  .founder-card__name { font-size: 1.3rem; margin-bottom: 0.25rem; }
  .founder-card__title { font-size: 0.9rem; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--gap-md); }
  .founder-card__bio { font-size: 1rem; color: var(--text-secondary); line-height: 1.8; }
</style>
