---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../config/siteData.json";
const service = siteData.services[0];
---

<BaseLayout title="Investment Opportunity" description={service.description}>
  <Header />
  <main>
    <section class="section">
      <div class="container container-narrow">
        <div class="section-label animate-in">Investment Opportunity</div>
        <h1 class="section-title animate-in animate-in-delay-1">{service.title}</h1>
        <p class="section-subtitle animate-in animate-in-delay-2">{service.description}</p>
        <a href="/invest" class="btn btn-primary btn-lg animate-in animate-in-delay-3">View Full Investment Details</a>
      </div>
    </section>
    <section class="section section-dark">
      <div class="container container-narrow">
        <h2 class="section-title">Why This Opportunity?</h2>
        <div class="accent-line"></div>
        <ul class="services__list">
          {service.features.map((f, i) => (
            <li class="services__item animate-in" style={`animation-delay: ${i * 0.08}s`}>
              <span class="services__check">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ff69b4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .services__list { list-style: none; display: flex; flex-direction: column; gap: var(--gap-lg); }
  .services__item { display: flex; gap: var(--gap-md); font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; }
  .services__check { flex-shrink: 0; margin-top: 2px; }
</style>
