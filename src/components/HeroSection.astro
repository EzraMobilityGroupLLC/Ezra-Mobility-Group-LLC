---
import siteData from "../config/siteData.json";
const { hero, brand } = siteData;
---

<section class="hero">
  <div class="hero__bg-glow"></div>
  <div class="container">
    <div class="hero__content">
      <div class="hero__badge animate-in animate-in-delay-1">
        <span class="hero__badge-dot"></span>
        Austin's Next Premium Fleet Venture
      </div>
      <h1 class="hero__headline animate-in animate-in-delay-2">{hero.headline}</h1>
      <p class="hero__subheadline animate-in animate-in-delay-3">{hero.subheadline}</p>
      <div class="hero__sig animate-in animate-in-delay-3">
        <span class="hero__sig-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff69b4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          {brand.signatureLook}
        </span>
      </div>
      <div class="hero__actions animate-in animate-in-delay-4">
        <a href="/invest" class="btn btn-primary btn-lg">View Investment Opportunity</a>
        <a href="/contact" class="btn btn-secondary btn-lg">Partner With Us</a>
      </div>
      <div class="hero__trust animate-in animate-in-delay-4">
        <div class="hero__trust-avatars"><span class="hero__mascot-icon">💎</span></div>
        <p class="hero__trust-text">Seeking <strong>investment partners &amp; owner-operators</strong> for a 6-SUV premium fleet — Uber Black / Lyft Black XL ready</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero { position: relative; min-height: 100vh; display: flex; align-items: center; padding-top: 70px; overflow: hidden; }
  .hero__bg-glow { position: absolute; top: -30%; left: 50%; transform: translateX(-50%); width: 800px; height: 800px; background: radial-gradient(circle, rgba(255,105,180,0.06) 0%, transparent 60%); pointer-events: none; }
  .hero__content { max-width: 820px; padding: 4rem 0; }
  .hero__badge { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-secondary); border: 1px solid var(--border-color); padding: 0.4rem 1rem; border-radius: 100px; margin-bottom: var(--gap-lg); }
  .hero__badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary); box-shadow: 0 0 10px var(--color-primary-glow); }
  .hero__headline { margin-bottom: 1.25rem; letter-spacing: -0.03em; }
  .hero__subheadline { font-size: 1.2rem; color: var(--text-secondary); max-width: 600px; line-height: 1.7; margin-bottom: var(--gap-md); }
  .hero__sig { margin-bottom: var(--gap-xl); }
  .hero__sig-badge { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 500; color: #ff69b4; background: rgba(255,105,180,0.08); border: 1px solid rgba(255,105,180,0.2); padding: 0.5rem 1rem; border-radius: var(--radius-sm); }
  .hero__actions { display: flex; gap: var(--gap-md); flex-wrap: wrap; margin-bottom: var(--gap-xl); }
  .hero__trust { display: flex; align-items: center; gap: var(--gap-md); }
  .hero__trust-avatars { display: flex; align-items: center; font-size: 1.4rem; }
  .hero__mascot-icon { filter: drop-shadow(0 0 8px rgba(255,105,180,0.4)); }
  .hero__trust-text { font-size: 0.9rem; color: var(--text-muted); margin: 0; }
  .hero__trust-text strong { color: var(--text-primary); }
  @media (max-width: 640px) {
    .hero__headline { font-size: 2.2rem; }
    .hero__subheadline { font-size: 1rem; }
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { width: 100%; justify-content: center; }
  }
</style>
